<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vtrack_secure.xml" />
        <exclude domain="file" path="datastore/vtrack_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Auth tokens must never move between devices. -->
        <exclude domain="sharedpref" path="vtrack_secure.xml" />
        <exclude domain="file" path="datastore/vtrack_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
